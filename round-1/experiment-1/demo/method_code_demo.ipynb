## Processing Functions

```python
def calculate_boiling_point(pressure_hpa):
    """Antoine equation for water."""
    pressure_mmhg = pressure_hpa * 0.750062
    A, B, C = 8.07131, 1730.63, 233.426
    t_celsius = B / (A - np.log10(pressure_mmhg)) - C
    return t_celsius

def generate_synthetic_data(n_points=N_POINTS, fs=FS, seed=None):
    """Generate synthetic high-frequency meteorological data."""
    if seed is not None:
        np.random.seed(seed)
    t = np.arange(n_points) / fs
    w = np.random.normal(0, 0.5, n_points)
    p_base = 1013.25
    p_non_hydro = 0.1 * w
    p_obs = p_base + p_non_hydro + np.random.normal(0, 0.05, n_points)
    t_base = calculate_boiling_point(p_base)
    t_obs = calculate_boiling_point(p_obs) + np.random.normal(0, 0.01, n_points)
    
    return pd.DataFrame({'time': t, 'P_obs': p_obs, 'T_obs': t_obs, 'w': w})
```

```python
# Running the experiment
results = []
for i in range(N_EXPERIMENTS):
    df = generate_synthetic_data(seed=i)
    df['T_calc'] = calculate_boiling_point(df['P_obs'])
    df['T_error'] = df['T_obs'] - df['T_calc']
    
    corr = np.corrcoef(df['T_error'], df['w'])[0, 1]
    results.append({
        'run': i + 1,
        'correlation': corr,
        'mean_t_error': df['T_error'].mean(),
        'std_t_error': df['T_error'].std()
    })

results_df = pd.DataFrame(results)
print(results_df)
```

